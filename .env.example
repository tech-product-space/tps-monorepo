# Unified environment for the monorepo (apps/api + apps/worker).
#
# Rules
#   * Shared infrastructure is unprefixed.
#   * Everything brand-specific is prefixed TPS_ / GRADIENT_ / CRM_. The code looks
#     for <BRAND>_<NAME> first and falls back to <NAME>, so a value that really is
#     identical across brands may be set once, unprefixed.
#   * JWT secrets MUST differ per brand (the gateway refuses to boot otherwise).
#   * Never commit real values. Copy to .env (gitignored).

# ---- shared ---------------------------------------------------------------
BRANDS=tps,gradient,crm
PORT=3000
NODE_ENV=production
# One database, one schema per brand. Format: postgres://user:pass@host:5432/dbname
DATABASE_URL=
# Same Redis for all brands (Gradient's BullMQ prefix is gradient:<env>, TPS uses the default "bull").
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
MONGO_DB_URL=
# Set to true only for a single-process deployment. Otherwise run apps/worker separately.
RUN_WORKERS_IN_API=false

# ---- per-brand schema + legacy hostnames ----------------------------------
TPS_PG_SCHEMA=tps
GRADIENT_PG_SCHEMA=gradient
CRM_PG_SCHEMA=crm
# Old API hostnames; requests to these are served at the root, as before.
TPS_LEGACY_HOSTS=api.theproductspace.in
GRADIENT_LEGACY_HOSTS=api.gradientlearnings.org
CRM_LEGACY_HOSTS=crm-api.theproductspace.in

# ---- tps ---------------------------------------------------------------
