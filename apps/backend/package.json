{
  "name": "@tps-monorepo/backend",
  "version": "1.0.0",
  "description": "Unified backend: BRAND=tps|gradient|crm selects which content domain boots (see server.js).",
  "main": "server.js",
  "scripts": {
    "postinstall": "npm install --prefix brands/gradient && npm install --prefix crm",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:tps": "cross-env BRAND=tps node server.js",
    "dev:tps": "cross-env BRAND=tps nodemon server.js",
    "start:gradient": "cross-env BRAND=gradient node server.js",
    "dev:gradient": "cross-env BRAND=gradient nodemon server.js",
    "start:crm": "cross-env BRAND=crm node server.js",
    "dev:crm": "cross-env BRAND=crm nodemon server.js",
    "worker:tps": "cross-env BRAND=tps node workers/workflowWorker.js",
    "worker:tps:dev": "cross-env BRAND=tps nodemon workers/workflowWorker.js",
    "worker:gradient": "cross-env BRAND=gradient node brands/gradient/src/worker.js",
    "worker:gradient:dev": "cross-env BRAND=gradient nodemon brands/gradient/src/worker.js",
    "migrate:tps": "sequelize-cli db:migrate",
    "migrate:gradient": "npm run pg:migrate --prefix brands/gradient",
    "migrate:crm": "npx sequelize-cli db:migrate --config crm/config/config.js --migrations-path crm/migrations --models-path crm/models",
    "backfill:workspace-grants": "node scripts/backfill-workspace-grants.js",
    "health:docker": "node dockerHealthCheck.js",
    "build:python-sandbox": "docker build -t python-sandbox -f sandbox/Dockerfile.python .",
    "build:javascript-sandbox": "docker build -t javascript-sandbox -f sandbox/Dockerfile.node ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/client-ses": "^3.1012.0",
    "@aws-sdk/lib-storage": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.914.0",
    "@azure/msal-node": "^3.6.4",
    "agenda": "^5.0.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "bullmq": "^5.76.8",
    "canvas": "^3.2.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "d": "^1.0.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "ulid": "^3.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.3"
  }
}
