{
  "name": "@ps/gradient",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "nodemon src/worker.js",
    "redis:up": "docker run -d --name gradient-redis -p 6379:6379 --restart unless-stopped redis:7-alpine redis-server --maxmemory-policy noeviction --appendonly yes",
    "redis:start": "docker start gradient-redis",
    "redis:stop": "docker stop gradient-redis",
    "redis:down": "docker rm -f gradient-redis",
    "redis:logs": "docker logs -f gradient-redis",
    "redis:cli": "docker exec -it gradient-redis redis-cli",
    "redis:ping": "docker exec gradient-redis redis-cli PING",
    "redis:check": "docker exec gradient-redis redis-cli CONFIG GET maxmemory-policy",
    "redis:flush": "docker exec gradient-redis redis-cli FLUSHALL",
    "pg:generate": "sequelize-cli migration:generate --name",
    "pg:generate:seeder": "sequelize-cli seed:generate --name",
    "pg:migrate": "sequelize-cli db:migrate",
    "pg:undo": "sequelize-cli db:migrate:undo",
    "pg:seed": "sequelize-cli db:seed --seed",
    "pg:seed:all": "sequelize-cli db:seed:all",
    "pg:seed:generate": "sequelize-cli seed:generate --name",
    "pg:seed:undo": "sequelize-cli db:seed:undo",
    "migrate": "sequelize-cli db:migrate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tech-product-space/gradient-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tech-product-space/gradient-backend/issues"
  },
  "homepage": "https://github.com/tech-product-space/gradient-backend#readme",
  "dependencies": {
    "@agendajs/postgres-backend": "^3.0.3",
    "@aws-sdk/client-s3": "^3.1015.0",
    "@aws-sdk/client-ses": "^3.1036.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@azure/msal-node": "^5.1.1",
    "@napi-rs/canvas": "^1.0.5",
    "agenda": "^6.2.3",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^10.6.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "ulid": "^3.0.2",
    "@ps/env": "*"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  },
  "private": true
}
