
# development/test/production
NODE_ENV=development

PORT=5000
POSTGRES_HOST=""
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

#Auth
JWT_SECRET=

# AWS S3 CLOUDFRONT CREDENTIALS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# CDN domain in front of the bucket. Only the S3 key is stored; every public
# URL is built from this, in both frontends too.
AWS_FILE_BASE_URL=https://assets.thegradient.co.in

# Bucket for objects that must NOT be publicly readable — certificates.
#
# The main bucket is fronted by the assets CDN, which serves everything in it
# regardless of object ACL, so a private-ACL object is still fetchable at
# <AWS_FILE_BASE_URL>/<key>. Without a separate no-CDN bucket here, presigned
# URLs are decorative and revoking a certificate does not actually revoke it.
# Falls back to the main bucket and warns at boot.
AWS_PRIVATE_BUCKET_NAME=

#Google
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

#mail
OUTLOOK_1_USER=
OUTLOOK_1_CLIENT_ID=
OUTLOOK_1_CLIENT_SECRET=
OUTLOOK_1_TENANT_ID=

AWS_SES_REGION=
AWS_SES_ACCES_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_FROM_MAIL=

# Sender for transactional mail: event guest emails (waitlisted / approved /
# declined / registered), course emails (enrollment acknowledgement, brochure /
# curriculum download), password resets, resource-lead mail and both template
# test sends. Change it here to move all of them at once.
#
# Must be one of the accounts wired up in src/services/email/config/
# emailAccounts.js — info@gradientlearnings.org, noreply@gradientlearnings.org
# or info@thegradient.co.in. Anything else has no transport and the server
# logs an error at boot. Defaults to info@gradientlearnings.org when unset.
#
# Does NOT affect certificates or admin mail (pinned to the noreply identity)
# or campaigns / reminders / workflows (sender picked per row in the panel).
DEFAULT_SENDER_EMAIL=info@gradientlearnings.org

# Display name beside that address. SES honours it; Outlook/Graph ignores it
# and sends as the mailbox's own name. Defaults to "Gradient Learnings".
DEFAULT_SENDER_NAME=Gradient Learnings

AGENDA_JOBS_ENABLED=

# ── Workflow automation ──────────────────────────────────────────────────────
# Off by default. With it false the API stops enqueuing and the worker consumes
# nothing — the rest of the product is unaffected, and only automation sleeps.
WORKFLOWS_ENABLED=false

# One URL, or the three parts. REDIS_URL wins when both are set.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Managed Redis usually needs this; a local one usually refuses it.
REDIS_TLS=false

# Namespace for every queue key. Defaults to gradient:<NODE_ENV>.
# MUST differ between environments that share a Redis instance — otherwise
# staging's worker consumes production's jobs and mails real people.
WORKFLOW_QUEUE_PREFIX=

# Worker concurrency. This is what meets the SES send rate, so raise it only
# against a known quota.
WORKFLOW_CONCURRENCY=5

# ── Secrets at rest ──────────────────────────────────────────────────────────
# AES-256-GCM key for secrets that must be readable again — currently Facebook
# page access tokens. Generate with: openssl rand -hex 32
#
# Exactly 64 hex characters. Not defaulted anywhere: tokenCrypto.js throws
# rather than fall back to a weak key, so accounts cannot be saved or read
# without it. Set it BEFORE running the meta migrations.
#
# Rotating it invalidates every stored token — there is no re-wrap path, and
# every Facebook account has to be reconnected by hand afterwards.
TOKEN_ENCRYPTION_KEY=

# Public site origin. Certificate emails link to a page here rather than to S3,
# because the object is private and any direct URL expires within the hour.
PUBLIC_SITE_URL=https://gradientlearnings.org

# Admin panel origin. Operational alerts link back into the panel, so a link to
# the public site would be no use to whoever has to fix the thing.
ADMIN_SITE_URL=https://admin.gradientlearnings.org

# ── Facebook lead ads ────────────────────────────────────────────────────────
# Deploy-level switch, read at boot. Off means the poll and form-sync jobs are
# defined but never scheduled, so there is no Graph traffic at all.
#
# This is NOT the switch operators use day to day — that is the Polling toggle
# in the panel (meta_settings.pollEnabled), which takes effect with no restart.
# AGENDA_JOBS_ENABLED must also be true; these run on Agenda like every other
# scheduled job.
META_INTEGRATION_ENABLED=false

# A Graph version bump should be a config change, not a code edit.
META_GRAPH_VERSION=v22.0

# Where the token-expiry alert goes. Leave blank to disable it.
#
# Worth setting in production: an expired page token is the one failure here
# that is otherwise completely silent. Facebook keeps collecting the leads, we
# just stop importing them, and nobody notices until someone opens the panel.
META_ALERT_EMAIL=
